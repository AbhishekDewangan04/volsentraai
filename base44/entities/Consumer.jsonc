{
  "name": "Consumer",
  "type": "object",
  "properties": {
    "consumer_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "feeder": {
      "type": "string"
    },
    "transformer_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Residential",
        "Commercial",
        "Industrial",
        "Agricultural"
      ]
    },
    "area": {
      "type": "string"
    },
    "risk_score": {
      "type": "number"
    },
    "cause": {
      "type": "string",
      "enum": [
        "Normal",
        "Theft/Tampering",
        "Meter Fault",
        "Communication Failure",
        "Legit Abnormal",
        "Requires Review"
      ]
    },
    "confidence": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "monitored",
        "flagged",
        "cleared"
      ]
    },
    "baseline_kwh": {
      "type": "number"
    },
    "actual_kwh": {
      "type": "number"
    },
    "peer_avg_kwh": {
      "type": "number"
    },
    "loss_pct": {
      "type": "number"
    },
    "monthly": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_seen": {
      "type": "string"
    },
    "x": {
      "type": "number"
    },
    "z": {
      "type": "number"
    }
  },
  "required": [
    "consumer_id",
    "name",
    "feeder",
    "transformer_id",
    "risk_score",
    "cause"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}